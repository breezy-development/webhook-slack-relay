# Shared secret you also paste into the GitHub webhook settings.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=change-me

# Slack incoming webhook URL. Leave empty for dry-run mode (logs instead of posting).
SLACK_WEBHOOK_URL=

# Optional
RELAY_EVENTS=push,pull_request,issues,release,workflow_run
RELAY_DB_PATH=relay.db
RELAY_MAX_ATTEMPTS=4
